@startuml
title scenario Process Al Fouad Transaction Job

legend top left
  Al Fouad state -> 121 status
  --
  3 (Paid) -> success
  1/ 2/ 4 (Pending_Approval/ Approved/ Hold) -> waiting
  5 (Canceled) -> error
endlegend

start
:System creates an 'initiated' or 'retry' transaction event;

:System gets nr of failed transaction attempts
 for this transactionId;
:System generates ReferenceNumber:
referenceId + transactionId + failedTransactionAttempts
Max 50 characters;

:System authenticates and calls
 Al Fouad TransactionCreate;

switch (Outcome?)
case (success)
  :System leaves transaction on 'waiting'
   and creates a success transaction event;

case (duplicate)
  :System calls getTransactionByRef
   with the same ReferenceNumber;
  if (Transaction found at Al Fouad?) then (yes)
    :System leaves transaction on 'waiting'
     and creates a success transaction event;
  else (no - inconsistent)
    :Duplicate reported but reference not
     found: set transaction 'error' and 
     create a failed transaction event;
  endif

case (error)
  :System updates transaction to 'error'
   and creates a failed transaction event;

case (timeout / no response)
  :System leaves transaction on 'waiting'; job ends;
endswitch

:System updates Redis in-progress set;
stop
@enduml