{
  "$schema": "https://json.schemastore.org/nest-cli.json",
  "compilerOptions": {
    "assets": [
      {
        "include": "**/*.json",
        "outDir": "dist"
      },
      {
        "include": "**/*.csv",
        "outDir": "dist"
      }
    ],
    "builder": {
      "options": {
        "extensions": [".js", ".ts"],
        "swcrcPath": ".swcrc"
      },
      "type": "swc"
    },
    "deleteOutDir": true,
    "manualRestart": true,
    "watchAssets": true
  }
}
